{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Amethyst",
  "version": "0.1.0",
  "identifier": "moe.geoxor.amethyst-player",
  "build": {
    "frontendDist": "../release",
    "devUrl": "http://localhost:6969",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Amethyst",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "fileAssociations": [
      {
        "ext": [
          "ang"
        ],
        "name": "Amethyst Node Graph",
        "description": "Amethyst Node Graph",
        "mimeType": "application/json",
        "rank": "Owner",
        "role": "Editor"
      },
      {
        "ext": [
          "acf"
        ],
        "name": "Amethyst Configuration File",
        "description": "Amethyst Configuration File",
        "mimeType": "application/json",
        "rank": "Owner",
        "role": "Editor"
      },
      {
        "ext": [
          "amf"
        ],
        "name": "Amethyst Metadata File",
        "description": "Amethyst Metadata File",
        "mimeType": "application/json",
        "rank": "Owner",
        "role": "Editor"
      },
      {
        "ext": [
          "ogg",
          "ogv",
          "oga",
          "ogx",
          "ogm",
          "spx",
          "wav",
          "wave",
          "m4a",
          "m4b",
          "m4p",
          "m4r",
          "m4v",
          "3gp",
          "flac",
          "opus",
          "aac",
          "aiff",
          "mp3",
          "m4a"
        ],
        "rank": "Default",
        "role": "Viewer"
      }
    ]
  }
}
